  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🚀 Painel de Tráfego e Performance (Visão Engenharia)",
      "type": "row"
    },
    {
      "title": "Requisições por Segundo (RPS - Throughput HTTP)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(promhttp_metric_handler_requests_total[1m]))",
          "legendFormat": "RPS Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "reqps"
        }
      }
    },
    {
      "title": "Heatmap de Latência das APIs (Tempo de Resposta)",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 10, "x": 8, "y": 1 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(opensearch_query_duration_seconds_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": {
        "calculate": false,
        "color": {
          "scheme": "Spectral"
        }
      }
    },
    {
      "title": "Taxa de Erros 5xx (Indicador Gauge)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "(sum(rate(promhttp_metric_handler_requests_total{code=~\"5..\"}[5m])) or vector(0)) / (sum(rate(promhttp_metric_handler_requests_total[5m])) or vector(1)) * 100",
          "legendFormat": "% Erros 5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 200,
      "title": "🔒 Painel de Auditoria e Negócio (Visão Produto/Segurança)",
      "type": "row"
    },
    {
      "title": "Últimas Falhas de Login Crítico (Tempo Real)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "OpenSearch" },
          "query": "event:user_login AND status:failed",
          "queryType": "lucene"
        }
      ]
    },
    {
      "title": "Funcionalidades Mais Acessadas (Gráfico de Barras)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "OpenSearch" },
          "query": "event:http_request",
          "queryType": "lucene"
        }
      ]
    },
    {
      "title": "Origem de Acessos por IP / Cliente (Geográfico & Segurança)",
      "type": "table",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 10 },
      "id": 6,
      "targets": [
        {
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "OpenSearch" },
          "query": "*",
          "queryType": "lucene"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 300,
      "title": "🖥️ Painel de Saúde da Infraestrutura e Cluster",
      "type": "row"
    },
    {
      "title": "Uso de Memória e Recursos do Processo Go (API & Indexer)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 7,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "process_resident_memory_bytes{job=~\"api|indexer\"}",
          "legendFormat": "{{job}} - Resident Memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "title": "Goroutines Ativas & Conexões Abertas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 8,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "go_goroutines{job=~\"api|indexer\"}",
          "legendFormat": "{{job}} - Goroutines"
        }
      ]
    },
    {
      "title": "OpenSearch CDC Bulk Indexing Rate & Sync Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 9,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(cdc_bulk_items_indexed_total[1m]))",
          "legendFormat": "CDC Indexed Items / sec"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(cdc_sync_lag_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 CDC Lag (s)"
        }
      ]
    }
  ],
  "refresh": "5s",
